<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openlib.market.frontend.controller.PublishBookController"
            stylesheets="@../styles/publicar_libro.css"
            styleClass="main-container">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
            <Label text="Vendedor" styleClass="sidebar-title"/>
            <Separator styleClass="sidebar-separator"/>
            <Button text="📊 Dashboard"   onAction="#handleGoToDashboard"  styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="📚 Mis Libros"  onAction="#handleGoToInventory"  styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="➕ Nuevo Libro" styleClass="sidebar-btn, active-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="← Catálogo"     onAction="#handleBackToCatalog"  styleClass="sidebar-btn-back" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="content-scroll">
                <VBox spacing="25">
                    <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

                    <!-- Header -->
                    <VBox spacing="5">
                        <Label text="Publicar Nuevo Libro" styleClass="page-title"/>
                        <Label text="Completa los metadatos y sube los archivos de tu obra." styleClass="page-subtitle"/>
                    </VBox>
                    <Separator/>

                    <!-- Two-column form -->
                    <HBox spacing="30" VBox.vgrow="ALWAYS">

                        <!-- LEFT: Metadata form -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                            <Label text="Metadatos del Libro" styleClass="section-title"/>

                            <VBox spacing="5">
                                <Label text="Título *" styleClass="field-label"/>
                                <TextField fx:id="tituloField" promptText="Ej: El Quijote de la Mancha" styleClass="input-field"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Autor *" styleClass="field-label"/>
                                <TextField fx:id="autorField" promptText="Ej: Miguel de Cervantes" styleClass="input-field"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="Descripción / Sinopsis *" styleClass="field-label"/>
                                <TextArea fx:id="descripcionField"
                                          promptText="Escribe una descripción atractiva del libro..."
                                          styleClass="input-field, textarea-field"
                                          wrapText="true"
                                          prefRowCount="5"/>
                            </VBox>

                            <HBox spacing="15">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Precio (\$)" styleClass="field-label"/>
                                    <TextField fx:id="precioField" promptText="Ej: 12.99" styleClass="input-field"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="ISBN" styleClass="field-label"/>
                                    <TextField fx:id="isbnField" promptText="Ej: 978-3-16-148410-0" styleClass="input-field"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Stock *" styleClass="field-label"/>
                                    <TextField fx:id="stockField" promptText="Ej: 10" styleClass="input-field"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="5">
                                <Label text="Categoría / Género *" styleClass="field-label"/>
                                <ComboBox fx:id="categoriaCombo" promptText="Selecciona una categoría..." maxWidth="Infinity" styleClass="input-field"/>
                            </VBox>
                        </VBox>

                        <!-- RIGHT: File upload zones -->
                        <VBox spacing="20" prefWidth="320" minWidth="280">
                            <Label text="Archivos" styleClass="section-title"/>

                            <!-- Cover image zone -->
                            <VBox spacing="10">
                                <Label text="Portada (JPG / PNG) *" styleClass="field-label"/>
                                <VBox fx:id="coverDropZone" styleClass="drop-zone" alignment="CENTER" spacing="10" onMouseClicked="#handleSelectCover">
                                    <Label text="🖼" styleClass="drop-icon"/>
                                    <Label fx:id="coverFileLabel" text="Clic para seleccionar imagen" styleClass="drop-hint"/>
                                </VBox>
                            </VBox>

                            <!-- Content file zone -->
                            <VBox spacing="10">
                                <Label text="Archivo de Contenido (PDF / EPUB) *" styleClass="field-label"/>
                                <VBox fx:id="previewDropZone" styleClass="drop-zone" alignment="CENTER" spacing="10" onMouseClicked="#handleSelectPreview">
                                    <Label text="📄" styleClass="drop-icon"/>
                                    <Label fx:id="previewFileLabel" text="Clic para seleccionar PDF o EPUB" styleClass="drop-hint"/>
                                </VBox>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Error label -->
                    <Label fx:id="errorLabel" text="" styleClass="error-message" visible="false" managed="false" wrapText="true"/>

                    <!-- Progress section -->
                    <VBox fx:id="progressContainer" spacing="10" visible="false" managed="false">
                        <Label fx:id="progressLabel" text="Preparando subida..." styleClass="progress-text"/>
                        <ProgressBar fx:id="uploadProgress" progress="0" maxWidth="Infinity" styleClass="upload-progress-bar"/>
                    </VBox>

                    <!-- Submit -->
                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="Cancelar" onAction="#handleGoToInventory" styleClass="cancel-btn"/>
                        <Button fx:id="publishButton" text="🚀 Publicar Libro" onAction="#handlePublish" styleClass="publish-btn"/>
                    </HBox>

                </VBox>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>

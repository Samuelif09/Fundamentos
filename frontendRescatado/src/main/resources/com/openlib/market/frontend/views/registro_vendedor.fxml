<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.openlib.market.frontend.controller.SellerRegistrationController"
           styleClass="root-pane"
           stylesheets="@../styles/login.css">

    <!-- Fondo con gradiente -->
    <Pane styleClass="bg-gradient" />

    <!-- Tarjeta centrada -->
    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-container" style="-fx-background-color: transparent; -fx-padding: 0;">
        <VBox alignment="CENTER" style="-fx-background-color: transparent;">
            <VBox styleClass="login-card" alignment="CENTER" maxWidth="500">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <!-- Header -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="Tienda OpenLib" styleClass="brand-subtitle" />
                    <Label text="Registro de Vendedor" styleClass="brand-name" />
                    <Label text="Comienza a vender tus libros digitales" styleClass="brand-subtitle" />
                </VBox>

                <Separator styleClass="card-separator">
                    <VBox.margin><Insets top="20" bottom="20" /></VBox.margin>
                </Separator>

                <!-- Formulario -->
                <VBox spacing="14" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Razón Social / Nombre Comercial *" styleClass="field-label" />
                        <TextField fx:id="businessNameField" promptText="Ej: Ediciones Century" styleClass="input-field" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Identificación Tributaria (NIT/RUT) *" styleClass="field-label" />
                        <TextField fx:id="taxIdField" promptText="Ej: 900.123.456-7" styleClass="input-field" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Correo Electrónico (Login) *" styleClass="field-label" />
                        <TextField fx:id="emailField" promptText="contacto@ejemplo.com" styleClass="input-field" />
                    </VBox>

                    <HBox spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Contraseña *" styleClass="field-label" />
                            <PasswordField fx:id="passwordField" promptText="Mínimo 8 caracteres" styleClass="input-field" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Confirmar Contraseña *" styleClass="field-label" />
                            <PasswordField fx:id="confirmPasswordField" promptText="Confirmar contraseña" styleClass="input-field" />
                        </VBox>
                    </HBox>

                    <!-- Error label -->
                    <Label fx:id="errorLabel" text="" styleClass="error-label" visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>

                    <!-- Action Button -->
                    <Button fx:id="registerButton" text="Solicitar Cuenta de Vendedor" styleClass="btn-primary" maxWidth="Infinity" onAction="#handleRegister" />

                    <!-- Loading overlay -->
                    <HBox fx:id="loadingContainer" alignment="CENTER" visible="false" spacing="10" managed="false">
                        <ProgressIndicator styleClass="loader" maxWidth="20" maxHeight="20"/>
                        <Label text="Procesando solicitud..." style="-fx-text-fill: white;"/>
                    </HBox>
                </VBox>

                <Separator styleClass="card-separator">
                    <VBox.margin><Insets top="25" bottom="20" /></VBox.margin>
                </Separator>

                <!-- Footer -->
                <HBox alignment="CENTER" spacing="5">
                    <Label text="¿Ya eres vendedor o cliente?" styleClass="footer-text" />
                    <Hyperlink text="Inicia sesión" styleClass="link-accent" onAction="#handleGoToLogin" />
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>

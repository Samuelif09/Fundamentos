<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openlib.market.frontend.controller.AdminConfigController"
            stylesheets="@../styles/config_admin.css"
            styleClass="main-container">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
            <Label text="Admin Portal" styleClass="sidebar-title"/>
            <Separator styleClass="sidebar-separator"/>
            <Button text="📊 Dashboard Global" onAction="#handleGoToDashboard" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="🔎 Curaduría" onAction="#handleGoToCuration" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="⚙️ Gestión y Usuarios" onAction="#handleGoToManagement" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="🎧 Mesa de Ayuda" onAction="#handleGoToSupport" styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="⚙️ Config. Sistema" styleClass="sidebar-btn, active-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Cerrar Sesión" onAction="#handleLogout" styleClass="sidebar-btn-logout" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="content-scroll">
                <VBox spacing="25">
                    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Label text="Configuración del Sistema" styleClass="page-title"/>
                            <Label text="Ajustes globales de plataforma, pagos y taxonomía." styleClass="page-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="⟳ Recargar Configuración" onAction="#handleRefresh" styleClass="refresh-btn"/>
                    </HBox>

                    <Separator/>

                    <!-- Card 1: Métodos de Pago -->
                    <VBox styleClass="config-card" spacing="15">
                        <Label text="💳 Pasarelas de Pago Habilitadas" styleClass="card-title"/>
                        <Label text="Activa o desactiva los métodos de pago disponibles en el Checkout para los compradores." styleClass="card-subtitle" wrapText="true"/>
                        
                        <ListView fx:id="paymentMethodsList" prefHeight="160" styleClass="clean-list"/>
                    </VBox>

                    <HBox spacing="20">
                        <!-- Card 2: Comisiones (Izquierda) -->
                        <VBox styleClass="config-card" spacing="15" HBox.hgrow="ALWAYS">
                            <Label text="💰 Fee de la Plataforma" styleClass="card-title"/>
                            <Label text="Porcentaje retenido por OpenLib en cada venta." styleClass="card-subtitle" wrapText="true"/>
                            
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Porcentaje:" styleClass="form-label"/>
                                <TextField fx:id="txtCommission" prefWidth="80" styleClass="input-field"/>
                                <Label text="%" styleClass="form-label"/>
                            </HBox>
                            
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Guardar Fee" onAction="#handleSaveCommission" styleClass="btn-primary" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Card 3: Categorías (Derecha) -->
                        <VBox styleClass="config-card" spacing="15" HBox.hgrow="ALWAYS">
                            <Label text="📚 Taxonomía de Categorías" styleClass="card-title"/>
                            <Label text="Gestiona las categorías base disponibles para publicación." styleClass="card-subtitle" wrapText="true"/>
                            
                            <ListView fx:id="categoriesList" prefHeight="150" styleClass="clean-list"/>
                            
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="txtNewCategory" promptText="Nueva categoría..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
                                <Button text="Añadir" onAction="#handleAddCategory" styleClass="btn-secondary"/>
                            </HBox>
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>

            <!-- Loading overlay -->
            <VBox fx:id="loadingContainer" alignment="CENTER" visible="true" styleClass="loading-overlay">
                <ProgressIndicator/>
                <Label text="Sincronizando configuración..."/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>

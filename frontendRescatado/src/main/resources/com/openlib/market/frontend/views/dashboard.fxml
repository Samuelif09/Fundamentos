<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openlib.market.frontend.controller.DashboardController"
            styleClass="root-pane"
            stylesheets="@../styles/dashboard.css">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="10">
            <!-- Brand -->
            <Label text="📚 OpenLib" styleClass="brand-title" />
            
            <Separator style="-fx-background-color: #2a3152; -fx-padding: 0; -fx-opacity: 0.5;">
                <VBox.margin><Insets bottom="10" /></VBox.margin>
            </Separator>

            <!-- Navigation Links -->
            <Button text="🏠  Inicio" styleClass="nav-button, nav-button-active" maxWidth="Infinity" />
            <Button text="📖  Catálogo" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToCatalog"/>
            <Button text="📚  Mi Biblioteca" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToLibrary"/>
            <Button text="🛒  Carrito" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToCart"/>
            
            <Region VBox.vgrow="ALWAYS" /> <!-- Espaciador -->

            <!-- Bottom Actions -->
            <Button text="👤  Perfil" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToProfile"/>
            <Button text="🚪  Cerrar Sesión" styleClass="logout-button" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <VBox>
            <!-- TOPBAR -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="20">
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="greetingLabel" text="¡Hola, Lector!" styleClass="greeting-text" />
                    <Label text="Encuentra tu próxima lectura hoy." styleClass="greeting-subtext" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Search -->
                <TextField promptText="🔍 Buscar libros, autores..." styleClass="search-field" prefWidth="300" />
                
                <!-- Notificaciones -->
                <Button text="🔔" style="-fx-background-color: #1e2440; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 16px; -fx-cursor: hand;" />
                
                <!-- Avatar -->
                <Circle radius="18" fill="#4f46e5" />
            </HBox>

            <!-- SCROLLABLE CONTENT -->
            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <VBox styleClass="content-area">
                    
                    <!-- HERO BANNER -->
                    <HBox styleClass="hero-banner" alignment="CENTER_LEFT">
                        <VBox spacing="15" HBox.hgrow="ALWAYS">
                            <Label text="Oferta Especial de Invierno" style="-fx-text-fill: #63ffb5; -fx-font-weight: bold;" />
                            <Label text="Descubre mundos increíbles con hasta 50% de descuento." styleClass="hero-title" wrapText="true" maxWidth="400"/>
                            <Label text="Explora novelas de ciencia ficción, fantasía y bestsellers globales a precios irrepetibles." styleClass="hero-subtitle" wrapText="true" maxWidth="450"/>
                            <Button text="Explorar Ofertas" styleClass="hero-button">
                                <VBox.margin><Insets top="10"/></VBox.margin>
                            </Button>
                        </VBox>
                        <!-- Aquí se podría colocar una imagen representativa -->
                        <Label text="📖✨" style="-fx-font-size: 80px; -fx-text-fill: rgba(255,255,255,0.4);" />
                    </HBox>

                    <!-- SECCIÓN: RECOMENDADOS -->
                    <VBox spacing="15">
                        <VBox.margin><Insets top="20"/></VBox.margin>
                        <Label text="Recomendados para ti" styleClass="section-title" />
                        
                        <!-- GRID DE LIBROS DINÁMICO -->
                        <FlowPane fx:id="recommendedFlowPane" hgap="20" vgap="20">
                        </FlowPane>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>

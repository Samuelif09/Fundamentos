<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.openlib.market.frontend.controller.LoginController"
           styleClass="root-pane"
           stylesheets="@../styles/login.css">

    <!-- Fondo con gradiente (definido en CSS) -->
    <Pane styleClass="bg-gradient" />

    <!-- Tarjeta de login centrada -->
    <VBox styleClass="login-card" alignment="CENTER" maxWidth="440" maxHeight="600">

        <!-- Logo / Ícono -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="📚" styleClass="logo-icon" />
            <Label text="OpenLib Market" styleClass="brand-name" />
            <Label text="Tu biblioteca digital de confianza" styleClass="brand-subtitle" />
        </VBox>

        <Separator styleClass="card-separator" VBox.vgrow="NEVER">
            <VBox.margin><Insets top="20" bottom="20" /></VBox.margin>
        </Separator>

        <!-- Formulario -->
        <VBox spacing="14" alignment="CENTER_LEFT">

            <!-- Email -->
            <VBox spacing="5">
                <Label text="Correo electrónico" styleClass="field-label" />
                <TextField fx:id="emailField"
                           promptText="nombre@ejemplo.com"
                           styleClass="input-field" />
            </VBox>

            <!-- Password -->
            <VBox spacing="5">
                <Label text="Contraseña" styleClass="field-label" />
                <PasswordField fx:id="passwordField"
                               promptText="Tu contraseña"
                               styleClass="input-field" />
            </VBox>

            <!-- Error label -->
            <Label fx:id="errorLabel"
                   text=""
                   styleClass="error-label"
                   wrapText="true"
                   maxWidth="Infinity" />

            <!-- Botón Login -->
            <Button fx:id="loginButton"
                    text="Iniciar Sesión"
                    styleClass="btn-primary"
                    maxWidth="Infinity"
                    onAction="#handleLogin" />

            <!-- Loader -->
            <ProgressIndicator fx:id="loadingIndicator"
                               styleClass="loader"
                               visible="false"
                               maxWidth="36" maxHeight="36" />

            <!-- Recuperar contraseña -->
            <HBox alignment="CENTER">
                <Hyperlink text="¿Olvidaste tu contraseña?"
                           styleClass="link-secondary"
                           onAction="#handleForgotPassword" />
            </HBox>

        </VBox>

        <Separator styleClass="card-separator">
            <VBox.margin><Insets top="20" bottom="16" /></VBox.margin>
        </Separator>

        <!-- Footer -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="¿No tienes cuenta?" styleClass="footer-text" />
            <Hyperlink text="Regístrate aquí" styleClass="link-accent" onAction="#handleGoToRegister" />
        </HBox>

    </VBox>

</StackPane>

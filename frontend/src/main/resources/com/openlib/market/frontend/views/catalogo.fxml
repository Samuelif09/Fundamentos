<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.openlib.market.frontend.controller.CatalogoController"
            stylesheets="@../styles/catalogo.css"
            styleClass="main-container">

    <!-- Top Navbar -->
    <top>
        <HBox styleClass="navbar" spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>
            <Label text="OpenLib Market" styleClass="logo-text"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <HBox styleClass="search-container" alignment="CENTER" spacing="10">
                <TextField fx:id="searchField" promptText="Buscar libros por título, autor..." styleClass="search-input" prefWidth="400"/>
                <Button text="Buscar" onAction="#handleSearch" styleClass="search-button"/>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button text="📚 Mi Biblioteca" onAction="#handleGoToLibrary" styleClass="library-button"/>
            <Button text="🛒 Carrito" onAction="#handleGoToCart" styleClass="cart-button"/>
            <Button text="Mi Cuenta" onAction="#handleGoToProfile" styleClass="account-button"/>
        </HBox>
    </top>

    <!-- Left Sidebar for Filters -->
    <left>
        <VBox styleClass="sidebar" spacing="20" prefWidth="250">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="Filtros" styleClass="sidebar-title"/>
            
            <!-- Categorías -->
            <VBox spacing="10">
                <Label text="Categorías" styleClass="filter-subtitle"/>
                <RadioButton text="Todos" fx:id="catAll" selected="true" onAction="#handleCategoryFilter"/>
                <RadioButton text="Ficción" fx:id="catFiction" onAction="#handleCategoryFilter"/>
                <RadioButton text="Tecnología" fx:id="catTech" onAction="#handleCategoryFilter"/>
                <RadioButton text="Ciencia" fx:id="catScience" onAction="#handleCategoryFilter"/>
                <RadioButton text="Historia" fx:id="catHistory" onAction="#handleCategoryFilter"/>
            </VBox>
            
            <Separator/>
            
            <!-- Rango de Precio -->
            <VBox spacing="10">
                <Label text="Rango de Precio" styleClass="filter-subtitle"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField promptText="Min" prefWidth="70" fx:id="minPriceField"/>
                    <Label text="-"/>
                    <TextField promptText="Max" prefWidth="70" fx:id="maxPriceField"/>
                </HBox>
                <Button text="Aplicar" styleClass="apply-filter-btn" onAction="#handlePriceFilter"/>
            </VBox>
            
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="catalog-scroll-pane">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <TilePane fx:id="booksGrid" hgap="20" vgap="20" prefColumns="4" styleClass="books-grid"/>
            </ScrollPane>
            
            <!-- Loading indicator -->
            <VBox fx:id="loadingContainer" alignment="CENTER" visible="false" styleClass="loading-overlay">
                <ProgressIndicator/>
                <Label text="Cargando catálogo..."/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.openlib.market.frontend.controller.ProfileController"
            stylesheets="@../styles/perfil.css"
            styleClass="main-container">

    <!-- Top Navbar -->
    <top>
        <HBox styleClass="navbar" spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>
            <Label text="OpenLib Market" styleClass="logo-text"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button text="← Volver al Catálogo" onAction="#handleBackToCatalog" styleClass="back-button"/>
        </HBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <StackPane>
            <VBox spacing="0">
                
                <!-- Header -->
                <VBox styleClass="profile-header" alignment="CENTER" spacing="15">
                    <padding>
                        <Insets top="40" bottom="30"/>
                    </padding>
                    <StackPane>
                        <Circle radius="50" fill="#E2E8F0" stroke="#CBD5E1" strokeWidth="2"/>
                        <Label fx:id="avatarInitialsLabel" text="?" styleClass="avatar-text"/>
                    </StackPane>
                    <Label fx:id="headerNameLabel" text="Cargando perfil..." styleClass="header-name"/>
                </VBox>
                
                <!-- Tabs -->
                <TabPane fx:id="profileTabs" tabClosingPolicy="UNAVAILABLE" styleClass="profile-tab-pane" VBox.vgrow="ALWAYS">
                    
                    <!-- Tab 1: Datos Personales -->
                    <Tab text="Datos Personales">
                        <ScrollPane fitToWidth="true" styleClass="content-scroll">
                            <VBox spacing="20" styleClass="tab-content">
                                <padding>
                                    <Insets top="30" right="40" bottom="40" left="40"/>
                                </padding>
                                
                                <Label text="Información de Contacto" styleClass="section-title"/>
                                <Separator/>
                                
                                <GridPane hgap="20" vgap="20">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150" prefWidth="200"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    
                                    <Label text="Nombre Completo:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <Label fx:id="fullNameLabel" text="-" styleClass="field-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    
                                    <Label text="Correo Electrónico:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <Label fx:id="emailLabel" text="-" styleClass="field-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    
                                    <Label text="Miembro desde:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <Label fx:id="joinedDateLabel" text="-" styleClass="field-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                </GridPane>
                                
                            </VBox>
                        </ScrollPane>
                    </Tab>
                    
                    <!-- Tab 2: Historial de Compras -->
                    <Tab text="Historial de Compras">
                        <ScrollPane fitToWidth="true" styleClass="content-scroll">
                            <VBox spacing="20" styleClass="tab-content">
                                <padding>
                                    <Insets top="30" right="40" bottom="40" left="40"/>
                                </padding>
                                
                                <Label text="Tus Pedidos Anteriores" styleClass="section-title"/>
                                <Separator/>
                                
                                <VBox fx:id="ordersContainer" spacing="15">
                                    <!-- Order items injected here dynamically -->
                                </VBox>
                                
                            </VBox>
                        </ScrollPane>
                    </Tab>
                    
                    <!-- Tab 3: Estadísticas -->
                    <Tab text="Estadísticas de Lectura">
                        <ScrollPane fitToWidth="true" styleClass="content-scroll">
                            <VBox spacing="20" styleClass="tab-content" alignment="TOP_CENTER">
                                <padding>
                                    <Insets top="30" right="40" bottom="40" left="40"/>
                                </padding>
                                
                                <Label text="Tu Actividad en OpenLib" styleClass="section-title"/>
                                <Separator/>
                                
                                <HBox spacing="30" alignment="CENTER">
                                    
                                    <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                                        <Label text="📚" styleClass="stat-icon"/>
                                        <Label fx:id="totalBooksLabel" text="0" styleClass="stat-number"/>
                                        <Label text="Libros en Biblioteca" styleClass="stat-label"/>
                                    </VBox>
                                    
                                    <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                                        <Label text="⏱" styleClass="stat-icon"/>
                                        <Label fx:id="readHoursLabel" text="0" styleClass="stat-number"/>
                                        <Label text="Horas de Lectura" styleClass="stat-label"/>
                                    </VBox>
                                    
                                    <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                                        <Label text="⭐" styleClass="stat-icon"/>
                                        <Label fx:id="favoriteGenreLabel" text="-" styleClass="stat-number" style="-fx-font-size: 24px;"/>
                                        <Label text="Género Favorito" styleClass="stat-label"/>
                                    </VBox>
                                    
                                </HBox>
                            </VBox>
                        </ScrollPane>
                    </Tab>
                    
                </TabPane>
            </VBox>
            
            <!-- Loading indicator -->
            <VBox fx:id="loadingContainer" alignment="CENTER" visible="true" styleClass="loading-overlay">
                <ProgressIndicator/>
                <Label text="Cargando información de tu cuenta..."/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>

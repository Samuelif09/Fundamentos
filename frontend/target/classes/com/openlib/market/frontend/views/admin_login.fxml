<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.openlib.market.frontend.controller.AdminLoginController"
           stylesheets="@../styles/admin_login.css"
           styleClass="main-container">

    <VBox alignment="CENTER" maxWidth="450" styleClass="login-card">
        <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>

        <!-- Cabecera -->
        <VBox alignment="CENTER" spacing="15">
            <Label text="Acceso Restringido — Solo Personal Autorizado" styleClass="admin-badge"/>
            
            <VBox alignment="CENTER" spacing="5">
                <Label text="🛡️" styleClass="logo-icon"/>
                <Label text="OpenLib Market" styleClass="app-title"/>
                <Label text="PORTAL DE ADMINISTRACIÓN" styleClass="app-subtitle"/>
            </VBox>
        </VBox>

        <Region prefHeight="35" />

        <!-- Formulario -->
        <VBox spacing="20">
            <!-- Email -->
            <VBox spacing="8">
                <Label text="Correo Administrativo" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="admin@openlib.market" styleClass="input-field"/>
            </VBox>

            <!-- Contraseña -->
            <VBox spacing="8">
                <Label text="Clave de Acceso" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="input-field"/>
            </VBox>

            <!-- Botón Login -->
            <Button text="Acceder al Sistema" 
                    fx:id="loginButton"
                    onAction="#handleLogin" 
                    maxWidth="Infinity" 
                    styleClass="login-btn">
                <VBox.margin><Insets top="10" /></VBox.margin>
            </Button>
        </VBox>

        <Separator styleClass="card-separator">
            <VBox.margin><Insets top="30" bottom="20" /></VBox.margin>
        </Separator>

        <!-- Footer -->
        <HBox alignment="CENTER">
            <Hyperlink text="← Volver al acceso de usuarios" styleClass="footer-link" onAction="#handleBackToPublicLogin" />
        </HBox>

    </VBox>

    <!-- Overlay de carga (oculto por defecto) -->
    <VBox fx:id="loadingContainer" alignment="CENTER" visible="false" styleClass="loading-overlay" spacing="15">
        <ProgressIndicator />
        <Label text="Verificando credenciales..." styleClass="loading-text"/>
    </VBox>

</StackPane>

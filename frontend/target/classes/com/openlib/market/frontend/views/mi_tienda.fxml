<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openlib.market.frontend.controller.MyStoreController"
            stylesheets="@../styles/mi_tienda.css"
            styleClass="main-container">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
            <Label text="Vendedor" styleClass="sidebar-title"/>
            <Separator styleClass="sidebar-separator"/>
            <Button text="📊 Dashboard"   onAction="#handleGoToDashboard"  styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="📚 Mis Libros"  onAction="#handleGoToInventory"  styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="➕ Nuevo Libro" onAction="#handleGoToPublish"    styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="💰 Billetera"   onAction="#handleGoToWallet"     styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="🏪 Mi Tienda"   styleClass="sidebar-btn, active-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="← Catálogo"     onAction="#handleBackToCatalog"  styleClass="sidebar-btn-back" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <StackPane>
            <VBox spacing="25">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="🏪 Mi Tienda" styleClass="page-title"/>
                        <Label text="Personaliza la identidad pública de tu tienda." styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="⟳ Actualizar" onAction="#handleRefresh" styleClass="refresh-btn"/>
                </HBox>

                <Separator/>

                <!-- TabPane -->
                <TabPane fx:id="storeTabs" tabClosingPolicy="UNAVAILABLE" styleClass="store-tab-pane" VBox.vgrow="ALWAYS">

                    <!-- Tab 1: Profile & Banner -->
                    <Tab text="Perfil y Banner">
                        <ScrollPane fitToWidth="true" styleClass="content-scroll">
                            <VBox spacing="20" styleClass="tab-content">
                                <padding><Insets top="25" right="30" bottom="30" left="30"/></padding>

                                <Label text="Información de la Tienda" styleClass="section-title"/>

                                <HBox spacing="30">
                                    <!-- Form -->
                                    <VBox spacing="15" HBox.hgrow="ALWAYS">
                                        <VBox spacing="5">
                                            <Label text="Nombre de la Tienda" styleClass="field-label"/>
                                            <TextField fx:id="storeNameField" promptText="Ej: Ediciones del Sur" styleClass="input-field"/>
                                        </VBox>
                                        <VBox spacing="5">
                                            <Label text="Correo de Contacto Público" styleClass="field-label"/>
                                            <TextField fx:id="contactEmailField" promptText="ventas@tutienda.com" styleClass="input-field"/>
                                        </VBox>
                                        <Button text="💾 Guardar Perfil" onAction="#handleSaveProfile" styleClass="save-btn"/>
                                    </VBox>

                                    <!-- Banner preview & upload -->
                                    <VBox spacing="15" minWidth="280" maxWidth="320">
                                        <Label text="Banner Visual" styleClass="field-label"/>
                                        <StackPane styleClass="banner-preview-container">
                                            <ImageView fx:id="bannerPreview" fitWidth="300" fitHeight="160" preserveRatio="true"/>
                                            <Label fx:id="bannerPlaceholder" text="Sin banner" styleClass="banner-placeholder"/>
                                        </StackPane>
                                        <Button text="🖼 Subir Nuevo Banner" onAction="#handleUploadBanner" styleClass="upload-btn" maxWidth="Infinity"/>
                                        <Label fx:id="bannerStatusLabel" text="" styleClass="banner-status"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </ScrollPane>
                    </Tab>

                    <!-- Tab 2: Public Description -->
                    <Tab text="Descripción Pública">
                        <ScrollPane fitToWidth="true" styleClass="content-scroll">
                            <VBox spacing="20" styleClass="tab-content">
                                <padding><Insets top="25" right="30" bottom="30" left="30"/></padding>

                                <Label text="Descripción Pública de tu Tienda" styleClass="section-title"/>
                                <Label text="Esta descripción será visible para los compradores en tu página de tienda." styleClass="field-hint"/>

                                <TextArea fx:id="descriptionArea"
                                          promptText="Escribe una presentación atractiva de tu catálogo y propuesta de valor..."
                                          styleClass="input-field, description-area"
                                          wrapText="true"
                                          prefRowCount="10"/>

                                <HBox alignment="CENTER_RIGHT">
                                    <Label fx:id="charCountLabel" text="0 / 1000 caracteres" styleClass="char-count"/>
                                </HBox>

                                <Button text="💾 Guardar Descripción" onAction="#handleSaveDescription" styleClass="save-btn" maxWidth="160"/>
                            </VBox>
                        </ScrollPane>
                    </Tab>

                    <!-- Tab 3: Affiliate Links -->
                    <Tab text="Links de Afiliado">
                        <ScrollPane fitToWidth="true" styleClass="content-scroll">
                            <VBox spacing="20" styleClass="tab-content">
                                <padding><Insets top="25" right="30" bottom="30" left="30"/></padding>

                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label text="Mis Links de Afiliado" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                                    <Button text="+ Agregar Link" onAction="#handleShowAddLink" styleClass="add-link-btn"/>
                                </HBox>

                                <!-- New link form (hidden by default) -->
                                <VBox fx:id="addLinkForm" styleClass="add-link-form" spacing="12" visible="false" managed="false">
                                    <Label text="Nuevo Enlace de Afiliado" styleClass="form-title"/>
                                    <HBox spacing="10">
                                        <TextField fx:id="linkLabelField" promptText="Nombre (ej: Instagram)" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                                        <TextField fx:id="linkCodeField"  promptText="Código afiliado" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <TextField fx:id="linkUrlField" promptText="https://..." styleClass="input-field" maxWidth="Infinity"/>
                                    <HBox spacing="10" alignment="CENTER_RIGHT">
                                        <Button text="Cancelar" onAction="#handleCancelAddLink" styleClass="cancel-btn"/>
                                        <Button text="Crear Link" onAction="#handleCreateLink"  styleClass="save-btn"/>
                                    </HBox>
                                </VBox>

                                <!-- Links list -->
                                <VBox fx:id="linksContainer" spacing="10">
                                    <!-- Populated dynamically -->
                                </VBox>

                            </VBox>
                        </ScrollPane>
                    </Tab>

                </TabPane>
            </VBox>

            <!-- Loading overlay -->
            <VBox fx:id="loadingContainer" alignment="CENTER" visible="true" styleClass="loading-overlay">
                <ProgressIndicator/>
                <Label text="Cargando tu tienda..."/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>

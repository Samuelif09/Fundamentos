<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openlib.market.frontend.controller.WalletController"
            stylesheets="@../styles/billetera_vendedor.css"
            styleClass="main-container">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
            <Label text="Vendedor" styleClass="sidebar-title"/>
            <Separator styleClass="sidebar-separator"/>
            <Button text="📊 Dashboard"   onAction="#handleGoToDashboard"  styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="📚 Mis Libros"  onAction="#handleGoToInventory"  styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="➕ Nuevo Libro" onAction="#handleGoToPublish"    styleClass="sidebar-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="💰 Billetera"   styleClass="sidebar-btn, active-btn" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="← Catálogo"     onAction="#handleBackToCatalog"  styleClass="sidebar-btn-back" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <StackPane>
            <VBox spacing="25">
                <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="💰 Billetera y Finanzas" styleClass="page-title"/>
                        <Label text="Historial de transacciones y solicitudes de retiro." styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="⟳ Actualizar" onAction="#handleRefresh" styleClass="refresh-btn"/>
                </HBox>

                <Separator/>

                <!-- KPI Cards -->
                <HBox spacing="20">
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="💵 Saldo Disponible" styleClass="kpi-label"/>
                        <Label fx:id="saldoDisponibleLabel" text="$0.00" styleClass="kpi-value, text-green"/>
                    </VBox>
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="📈 Total Ventas" styleClass="kpi-label"/>
                        <Label fx:id="totalVentasLabel" text="$0.00" styleClass="kpi-value"/>
                    </VBox>
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="📉 Total Comisiones" styleClass="kpi-label"/>
                        <Label fx:id="totalComisionesLabel" text="$0.00" styleClass="kpi-value, text-red"/>
                    </VBox>
                    <VBox styleClass="kpi-card, withdrawal-card" HBox.hgrow="NEVER" minWidth="200" alignment="CENTER" spacing="12">
                        <Label text="Solicitar Retiro" styleClass="kpi-label"/>
                        <Button fx:id="withdrawButton" text="💸 Solicitar Fondos" onAction="#handleWithdraw" styleClass="withdraw-btn"/>
                    </VBox>
                </HBox>

                <!-- Transactions Table -->
                <Label text="Historial de Transacciones" styleClass="section-title"/>
                <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS" styleClass="transactions-table">
                    <columns>
                        <TableColumn fx:id="colDate"        text="Fecha"       prefWidth="160"/>
                        <TableColumn fx:id="colType"        text="Tipo"        prefWidth="140"/>
                        <TableColumn fx:id="colDescription" text="Descripción" prefWidth="300"/>
                        <TableColumn fx:id="colAmount"      text="Monto"       prefWidth="140"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay transacciones registradas." styleClass="table-placeholder"/>
                    </placeholder>
                </TableView>

            </VBox>

            <!-- Loading overlay -->
            <VBox fx:id="loadingContainer" alignment="CENTER" visible="true" styleClass="loading-overlay">
                <ProgressIndicator/>
                <Label text="Cargando finanzas..."/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
